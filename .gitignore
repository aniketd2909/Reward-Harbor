# Dependencies and build output
node_modules/
/dist/
/build/
/coverage/
/.nyc_output/

# Credentials and environment overrides (keep the public setup template)
.env*
!.env.example

# Local checkout journal, savings database, sessions and SQLite sidecars
/.local-data/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Authenticated browser profiles and generated inspection artifacts
/.sandbox-browser/
/.browser-profile/
/playwright/.auth/
/artifacts/
/test-results/
/playwright-report/
/blob-report/

# Logs and transient runtime files
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.swp
*.swo
*~

# Local editor and operating-system files
/.idea/
/.vscode/
.DS_Store
._*
Thumbs.db
Desktop.ini

# Private keys and local certificates
*.pem
*.key
*.p12
*.pfx
